APP_NAME=payment-service
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true

DATABASE_URL=postgresql+asyncpg://payment:payment@postgres:5432/payment
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_QUEUE_PAYMENTS_NEW=payments.new
RABBITMQ_QUEUE_PAYMENTS_DLQ=payments.dlq
RABBITMQ_EXCHANGE_PAYMENTS=payments
RABBITMQ_MAX_RETRIES=3

API_KEY=pay-secret-key-change-in-production

WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_RETRIES=3

HOST=0.0.0.0
PORT=8000